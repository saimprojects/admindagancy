# Optional preferred production origin, for the canonical URL and sitemap.
# Set this in Vercel after attaching your custom domain, then redeploy.
# Without it, Vercel's production domain is detected automatically.
# SITE_URL=https://your-real-domain.com

# No email credentials or API keys are required by the current FormSubmit form.
# Never put secrets in variables prefixed with VITE_: they are browser-visible.
